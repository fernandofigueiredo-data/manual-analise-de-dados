::-<span class=\"tk-num\">1</span>]</span>\n<span class=\"ln\" data-n=\"4\">cores = [tema.CIANO <span class=\"tk-kw\">if</span> <span class=\"tk-str\">'</span><span class=\"tk-str\">atraso</span><span class=\"tk-str\">'</span> <span class=\"tk-kw\">in</span> v <span class=\"tk-kw\">else</span> tema.AMBAR <span class=\"tk-kw\">for</span> v <span class=\"tk-kw\">in</span> m3[<span class=\"tk-str\">'</span><span class=\"tk-str\">variável</span><span class=\"tk-str\">'</span>]]</span>\n<span class=\"ln\" data-n=\"5\"><span class=\"tk-kw\">for</span> yi, (_, r), cor <span class=\"tk-kw\">in</span> <span class=\"tk-bi\">zip</span>(y, m3.<span class=\"tk-fn\">iterrows</span>(), cores):</span>\n<span class=\"ln\" data-n=\"6\">    ax.<span class=\"tk-fn\">errorbar</span>(r.coef, yi, xerr=[[r.coef - r.ic95_inf], [r.ic95_sup - r.coef]], fmt=<span class=\"tk-str\">'</span><span class=\"tk-str\">none</span><span class=\"tk-str\">'</span>, ecolor=cor, capsize=<span class=\"tk-num\">4</span>, lw=<span class=\"tk-num\">2</span>)</span>\n<span class=\"ln\" data-n=\"7\">ax.<span class=\"tk-fn\">scatter</span>(m3.coef, y, color=cores, s=<span class=\"tk-num\">40</span>, zorder=<span class=\"tk-num\">3</span>)</span>\n<span class=\"ln\" data-n=\"8\">ax.<span class=\"tk-fn\">axvline</span>(<span class=\"tk-num\">0</span>, color=tema.TEXTO_2, lw=<span class=\"tk-num\">1</span>, ls=<span class=\"tk-str\">'</span><span class=\"tk-str\">--</span><span class=\"tk-str\">'</span>)</span>\n<span class=\"ln\" data-n=\"9\">ax.<span class=\"tk-fn\">set_yticks</span>(y, [<span class=\"tk-kw\">f</span><span class=\"tk-str\">\"</span><span class=\"tk-str\">{</span>r[<span class=\"tk-str\">'</span><span class=\"tk-str\">reclamações</span><span class=\"tk-str\">'</span>]<span class=\"tk-str\">}</span><span class=\"tk-str\"> · </span><span class=\"tk-str\">{</span>r[<span class=\"tk-str\">'</span><span class=\"tk-str\">variável</span><span class=\"tk-str\">'</span>]<span class=\"tk-str\">}</span><span class=\"tk-str\">\"</span> <span class=\"tk-kw\">for</span> _, r <span class=\"tk-kw\">in</span> m3.<span class=\"tk-fn\">iterrows</span>()])</span>\n<span class=\"ln\" data-n=\"10\">ax.<span class=\"tk-fn\">set</span>(title=<span class=\"tk-str\">'</span><span class=\"tk-str\">Modelo M3: variação nas reclamações por 100 mil pax (IC 95 </span><span class=\"tk-str\">%</span><span class=\"tk-str\">)</span><span class=\"tk-str\">'</span>,</span>\n<span class=\"ln\" data-n=\"11\">       xlabel=<span class=\"tk-str\">'</span><span class=\"tk-str\">reclamações / 100 mil pax por ponto percentual</span><span class=\"tk-str\">'</span>)</span>\n<span class=\"ln\" data-n=\"12\"><span class=\"tk-fn\">fonte</span>(fig)</span>\n<span class=\"ln\" data-n=\"13\">plt.<span class=\"tk-fn\">show</span>()</span></code></pre></div>\n<div class=\"saida\" data-pagefind-ignore=\"\"><p class=\"saida__rotulo\">Saída</p><figure class=\"figura\"><button aria-label=\"Ampliar imagem: Gráfico de coeficientes do modelo M3, com um ponto e um intervalo de confiança de 95 % para cada combinação de tipo de reclamação (todas, operacionais e cobrança) e variável (atraso e cancelamento). Os intervalos do cancelamento para todas as reclamações e para as operacionais ficam inteiramente à direita do zero; os do atraso cruzam o zero ou ficam muito perto dele; os da cobrança, o placebo, cruzam o zero.\" class=\"figura__ampliar\" data-ampliar=\"\" type=\"button\"><img alt=\"Gráfico de coeficientes do modelo M3, com um ponto e um intervalo de confiança de 95 % para cada combinação de tipo de reclamação (todas, operacionais e cobrança) e variável (atraso e cancelamento). Os intervalos do cancelamento para todas as reclamações e para as operacionais ficam inteiramente à direita do zero; os do atraso cruzam o zero ou ficam muito perto dele; os da cobrança, o placebo, cruzam o zero.\" decoding=\"async\" height=\"723\" loading=\"lazy\" src=\"/img/estudo-de-caso/celula-064.webp\" width=\"1991\"/><span class=\"figura__icone\"><svg aria-hidden=\"true\" class=\"icone\" fill=\"none\" focusable=\"false\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\"><path d=\"M15 3h6v6\"></path><path d=\"M9 21H3v-6\"></path><path d=\"m21 3-7 7\"></path><path d=\"m3 21 7-7\"></path></svg></span></button><figcaption>Fonte: ANAC (dados abertos). Elaboração própria.</figcaption></figure></div>\n<h3 id=\"secao-9-3\">9.3 Quanto do vaivém das reclamações a operação explica</h3>\n<p><strong>O que faz:</strong> compara o R² do modelo M3 com e sem as duas variáveis operacionais. A diferença é o quanto atraso e cancelamento acrescentam depois que os efeitos de companhia × ano e de mês do calendário já entraram.</p>\n<div class=\"codigo\" data-lang=\"python\"><div class=\"codigo__barra\" data-pagefind-ignore=\"\"><span class=\"codigo__lang\">python</span><button class=\"codigo__copiar\" data-copiar=\"\" type=\"button\">Copiar</button></div><pre aria-label=\"Código python\" class=\"codigo__pre\" tabindex=\"0\"><code><span class=\"ln\" data-n=\"1\">so_controles = smf.<span class=\"tk-fn\">ols</span>(<span class=\"tk-str\">'</span><span class=\"tk-str\">reclamacoes_100k ~ C(empresa):C(ano) + C(mes)</span><span class=\"tk-str\">'</span>, painel).<span class=\"tk-fn\">fit</span>()</span>\n<span class=\"ln\" data-n=\"2\">completo = modelos[(<span class=\"tk-str\">'</span><span class=\"tk-str\">reclamacoes_100k</span><span class=\"tk-str\">'</span>, <span class=\"tk-str\">'</span><span class=\"tk-str\">M3</span><span class=\"tk-str\">'</span>)]</span>\n<span class=\"ln\" data-n=\"3\">r2_controles, r2_completo = so_controles.rsquared, completo.rsquared</span>\n<span class=\"ln\" data-n=\"4\">r2_parcial = (r2_completo - r2_controles) / (<span class=\"tk-num\">1</span> - r2_controles)</span>\n<span class=\"ln\" data-n=\"5\"><span class=\"tk-bi\">print</span>(<span class=\"tk-kw\">f</span><span class=\"tk-str\">'</span><span class=\"tk-str\">R² só com companhia × ano e mês: </span><span class=\"tk-str\">{</span><span class=\"tk-fn\">br</span>(r2_controles, <span class=\"tk-num\">3</span>)<span class=\"tk-str\">}</span><span class=\"tk-str\"> | com atraso e cancelamento: </span><span class=\"tk-str\">{</span><span class=\"tk-fn\">br</span>(r2_completo, <span class=\"tk-num\">3</span>)<span class=\"tk-str\">}</span><span class=\"tk-str\"> | </span><span class=\"tk-str\">'</span></span>\n<span class=\"ln\" data-n=\"6\">      <span class=\"tk-kw\">f</span><span class=\"tk-str\">'</span><span class=\"tk-str\">R² parcial da operação: </span><span class=\"tk-str\">{</span><span class=\"tk-fn\">br</span>(r2_parcial, <span class=\"tk-num\">3</span>)<span class=\"tk-str\">}</span><span class=\"tk-str\">'</span>)</span>\n<span class=\"ln\" data-n=\"7\"><span class=\"tk-bi\">print</span>(<span class=\"tk-kw\">f</span><span class=\"tk-str\">'</span><span class=\"tk-str\">Durbin-Watson dos resíduos do M3: </span><span class=\"tk-str\">{</span><span class=\"tk-fn\">br</span>(<span class=\"tk-bi\">float</span>(np.<span class=\"tk-fn\">sum</span>(np.<span class=\"tk-fn\">diff</span>(completo.resid) ** <span class=\"tk-num\">2</span>) / np.<span class=\"tk-fn\">sum</span>(completo.resid ** <span class=\"tk-num\">2</span>)), <span class=\"tk-num\">2</span>)<span class=\"tk-str\">}</span><span class=\"tk-str\">'</span>)</span></code></pre></div>\n<div class=\"saida\" data-pagefind-ignore=\"\"><p class=\"saida__rotulo\">Saída</p><pre class=\"saida__texto\" tabindex=\"0\">R² só com companhia × ano e mês: 0,815 | com atraso e cancelamento: 0,867 | R² parcial da operação: 0,285\nDurbin-Watson dos resíduos do M3: 1,00</pre></div>\n<aside class=\"callout callout--atencao\"><p class=\"callout__titulo\"><svg aria-hidden=\"true\" class=\"icone\" fill=\"none\" focusable=\"false\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3\"></path><path d=\"M12 9v4\"></path><path d=\"M12 17h.01\"></path></svg><span>O que observar</span></p><div class=\"callout__corpo\"><ul>\n<li><strong>Falácia ecológica:</strong> a regressão é no nível companhia × mês. Ela diz que meses com mais cancelamentos têm mais reclamações por passageiro; não diz que um passageiro específico reclamou por causa de um cancelamento específico.</li>\n<li><strong>Associação, não causa:</strong> o modelo M3 e o placebo afastam as explicações mais óbvias, mas não todas (por exemplo, um mês com problema no sistema de vendas que também atrapalhe a operação).</li>\n<li>O consumidor.gov.br só tem quem decidiu reclamar ali. Uma mudança na divulgação da plataforma muda as reclamações sem mudar a operação; o efeito companhia × ano absorve parte disso.</li>\n</ul></div></aside>\n",
