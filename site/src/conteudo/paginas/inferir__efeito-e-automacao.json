{
 "slug": "inferir/efeito-e-automacao",
 "modulo": "inferir",
 "tipo": "nb",
 "titulo": "12. Estatística inferencial: tamanho de efeito, fluxo automatizado e pingouin",
 "nav": "12.9–12.11 Efeito e automação",
 "sobretitulo": "Notebook mestre",
 "descricao": "As diferenças observadas são estatisticamente significativas? E o teste A/B?",
