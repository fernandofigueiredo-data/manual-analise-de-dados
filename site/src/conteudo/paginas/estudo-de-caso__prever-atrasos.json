an><span class=\"tk-str\">'</span>, p_prev, tema.TEXTO_2), (<span class=\"tk-str\">'</span><span class=\"tk-str\">histórico companhia × hora</span><span class=\"tk-str\">'</span>, p_hist, tema.AMBAR),</span>\n<span class=\"ln\" data-n=\"4\">          (<span class=\"tk-str\">'</span><span class=\"tk-str\">gradient boosting</span><span class=\"tk-str\">'</span>, p_modelo, tema.CIANO)]</span>\n<span class=\"ln\" data-n=\"5\"><span class=\"tk-kw\">for</span> nome, p, cor <span class=\"tk-kw\">in</span> series[<span class=\"tk-num\">1</span>:]:</span>\n<span class=\"ln\" data-n=\"6\">    fpr, tpr, _ = <span class=\"tk-fn\">roc_curve</span>(teste.alvo, p)</span>\n<span class=\"ln\" data-n=\"7\">    axs[<span class=\"tk-num\">0</span>].<span class=\"tk-fn\">plot</span>(fpr, tpr, color=cor, lw=<span class=\"tk-num\">2</span>, label=nome)</span>\n<span class=\"ln\" data-n=\"8\">    prec, rec, _ = <span class=\"tk-fn\">precision_recall_curve</span>(teste.alvo, p)</span>\n<span class=\"ln\" data-n=\"9\">    axs[<span class=\"tk-num\">1</span>].<span class=\"tk-fn\">plot</span>(rec, prec, color=cor, lw=<span class=\"tk-num\">2</span>, label=nome)</span>\n<span class=\"ln\" data-n=\"10\">axs[<span class=\"tk-num\">0</span>].<span class=\"tk-fn\">plot</span>([<span class=\"tk-num\">0</span>, <span class=\"tk-num\">1</span>], [<span class=\"tk-num\">0</span>, <span class=\"tk-num\">1</span>], color=tema.TEXTO_2, ls=<span class=\"tk-str\">'</span><span class=\"tk-str\">--</span><span class=\"tk-str\">'</span>, lw=<span class=\"tk-num\">1</span>, label=<span class=\"tk-str\">'</span><span class=\"tk-str\">prevalência</span><span class=\"tk-str\">'</span>)</span>\n<span class=\"ln\" data-n=\"11\">axs[<span class=\"tk-num\">1</span>].<span class=\"tk-fn\">axhline</span>(teste.alvo.<span class=\"tk-fn\">mean</span>(), color=tema.TEXTO_2, ls=<span class=\"tk-str\">'</span><span class=\"tk-str\">--</span><span class=\"tk-str\">'</span>, lw=<span class=\"tk-num\">1</span>, label=<span cla