-str\">faixa</span><span class=\"tk-str\">'</span>).<span class=\"tk-fn\">mean</span>()</span>\n<span class=\"ln\" data-n=\"16\">axs[<span class=\"tk-num\">2</span>].<span class=\"tk-fn\">plot</span>([<span class=\"tk-num\">0</span>, calib.<span class=\"tk-fn\">max</span>().<span class=\"tk-fn\">max</span>() * <span class=\"tk-num\">1.1</span>], [<span class=\"tk-num\">0</span>, calib.<span class=\"tk-fn\">max</span>().<span class=\"tk-fn\">max</span>() * <span class=\"tk-num\">1.1</span>], color=tema.TEXTO_2, ls=<span class=\"tk-str\">'</span><span class=\"tk-str\">--</span><span class=\"tk-str\">'</span>, lw=<span class=\"tk-num\">1</span>)</span>\n<span class=\"ln\" data-n=\"17\">axs[<span class=\"tk-num\">2</span>].<span class=\"tk-fn\">plot</span>(calib.previsto, calib.observado, <span class=\"tk-str\">'</span><span class=\"tk-str\">o-</span><span class=\"tk-str\">'</span>, color=tema.CIANO, lw=<span class=\"tk-num\">2</span>)</span>\n<span class=\"ln\" data-n=\"18\">axs[<span class=\"tk-num\">2</span>].<span class=\"tk-fn\">set</span>(title=<span class=\"tk-str\">'</span><span class=\"tk-str\">Calibração (decis do risco previsto)</span><span class=\"tk-str\">'</span>, xlabel=<span class=\"tk-str\">'</span><span class=\"tk-str\">probabilidade prevista</span><span class=\"tk-str\">'</span>, ylabel=<span class=\"tk-str\">'</span><span class=\"tk-str\">taxa observada</span><span class=\"tk-str\">'</span>)</span>\n<span class=\"ln\" data-n=\"19\">axs[<span class=\"tk-num\">0</span>].<span class=\"tk-fn\">legend</span>(frameon=<span class=\"tk-kw\">False</span>, fontsize=<span class=\"tk-num\">8</span>)</span>\n<span class=\"ln\" data-n=\"20\"><span class=\"tk-fn\">fonte</span>(fig)</span>\n<span class=\"ln\" data-n=\"21\">plt.<span class=\"tk-fn\">show</span>()</span></code></pre></div>\n<div class=\"saida\" data-pagefind-ignore=\"\"><p class=\"saida__rotulo\">Saída</p><figure class=\"figura\"><button aria-label=\"Ampliar imagem: Três painéis de avaliação no teste 