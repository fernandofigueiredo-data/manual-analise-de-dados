---
import Base from '../layouts/Base.astro';
---
<Base titulo="Página não encontrada" descricao="A página procurada não existe neste manual." semToc>
  <header class="cabeca-pagina">
    <h1>Página não encontrada</h1>
    <p class="cabeca-pagina__descricao">O endereço pode ter mudado. Use a busca (tecla <kbd>/</kbd>) ou volte para a trilha.</p>
  </header>
  <p><a class="botao botao--primario" href="/">Ir para o início</a></p>
</Base>
